#!/usr/bin/env python3
"""
Photo Editor CLI - simple commands for humans and AI assistants alike.

Usage:
    photo button image.png          # Create a button
    photo banner image.png          # Create a banner
    photo upscale image.png         # AI upscale 4x
    photo rembg image.png           # Remove background
    photo watermark image.png       # Remove corner watermark
    photo vector image.png          # Convert to SVG
    photo resize image.png 800 600  # Resize to 800x600
    photo list                      # Show all presets

Run `photo help` for the full command reference.
"""

import sys
from pathlib import Path

# Make sibling modules importable no matter where `photo` is invoked from
sys.path.insert(0, str(Path(__file__).parent.absolute()))

from format_converter import FormatConverter
from photo_editor import PhotoEditor, UpscaleModel
from presets import ALL_PRESETS, FitMode, list_presets

OUTPUT_BASE = Path("output")

WATERMARK_POSITIONS = ("bottom-right", "bottom-left", "top-right", "top-left", "bottom-center")

# Shorthand command names -> preset names (see presets.py for the full table)
PRESET_SHORTHANDS = {
    "btn": "button",
    "twitter": "twitter_banner",
    "instagram": "instagram_post",
    "ig": "instagram_post",
    "story": "instagram_story",
    "facebook": "facebook_post",
    "fb": "facebook_post",
    "linkedin": "linkedin_post",
    "youtube": "youtube_thumbnail",
    "yt": "youtube_thumbnail",
    "thumb": "thumbnail",
    "card": "business_card",
}


def output_path(folder: str, filename: str) -> Path:
    """Path under ./output/<folder>/, creating the directory if needed."""
    out_dir = OUTPUT_BASE / folder
    out_dir.mkdir(parents=True, exist_ok=True)
    return out_dir / filename


def parse_watermark_args(tokens: list[str]) -> tuple[str, int, int, int]:
    """Parse ``[position] [height] [width] [padding]`` watermark arguments.

    Defaults target a small corner mark (like Gemini's sparkle) so detail
    near the corner isn't destroyed; pass explicit sizes for larger marks.
    """
    position = "bottom-right"
    if tokens and tokens[0] in WATERMARK_POSITIONS:
        position = tokens.pop(0)

    numbers = [int(t) for t in tokens[:3] if t.isdigit()]
    height = numbers[0] if len(numbers) > 0 else 28
    width = numbers[1] if len(numbers) > 1 else (numbers[0] if numbers else 36)
    padding = numbers[2] if len(numbers) > 2 else 8
    return position, height, width, padding


def main() -> int:
    # --fit keeps the whole image (letterbox) instead of cropping to fill
    use_fit_mode = "--fit" in sys.argv or "-f" in sys.argv
    args = [a for a in sys.argv if a not in ("--fit", "-f")]

    command = args[1].lower() if len(args) > 1 else ""

    if not command or command in ("help", "-h", "--help"):
        print_usage()
        if command:
            list_presets()
        return 0 if command else 1

    if command in ("list", "presets"):
        list_presets()
        return 0

    if len(args) < 3:
        print(f"Usage: photo {command} <image>")
        return 1

    input_path = Path(args[2])
    if not input_path.exists():
        print(f"Error: File not found: {input_path}")
        return 1

    editor = PhotoEditor()
    extra = args[3:]

    if command == "upscale":
        scale = int(extra[0]) if extra and extra[0].isdigit() else 4
        if scale not in (2, 4):
            scale = 4
        print(f"Upscaling {input_path} {scale}x...")
        result = editor.ai_upscale(
            input_path,
            output_path("upscaled", f"{input_path.stem}_upscaled_{scale}x.png"),
            scale=scale, model=UpscaleModel.from_name("general", scale),
        )

    elif command in ("rembg", "nobg", "removebg", "transparent"):
        print(f"Removing background from {input_path}...")
        result = editor.remove_background(
            input_path, output_path("no_background", f"{input_path.stem}_nobg.png"),
        )

    elif command in ("vector", "svg", "vectorize"):
        print(f"Converting {input_path} to SVG...")
        result = editor.vectorize(
            input_path, output_path("vectors", f"{input_path.stem}.svg"),
        )

    elif command == "resize":
        if len(extra) < 2:
            print("Usage: photo resize <image> <width> <height>")
            return 1
        width, height = int(extra[0]), int(extra[1])
        print(f"Resizing {input_path} to {width}x{height}...")
        result = editor.smart_resize(
            input_path,
            output_path("resized", f"{input_path.stem}_{width}x{height}.png"),
            width=width, height=height,
        )

    elif command in ("watermark", "nowm", "rmwm", "dewatermark"):
        position, height, width, padding = parse_watermark_args(extra)
        print(f"Editing corner of {input_path} ({position}, mask ~{width}x{height}+pad {padding})...")
        result = editor.remove_watermark(
            input_path,
            output_path("no_watermark", f"{input_path.stem}_nowm.png"),
            watermark_position=position,
            watermark_height=height, watermark_width=width, padding=padding,
        )

    else:
        preset_name = PRESET_SHORTHANDS.get(command, command)
        if preset_name not in ALL_PRESETS:
            print(f"Unknown command: {command}")
            print("\nAvailable commands:")
            print("  upscale, rembg, watermark, vector, resize")
            print("  button, banner, postcard, flyer, icon, thumbnail, hero...")
            print("\nRun 'photo list' to see all format presets")
            return 1

        mode_text = " (fit mode - keeping whole image)" if use_fit_mode else ""
        print(f"Converting {input_path} to {preset_name}{mode_text}...")
        converter = FormatConverter(output_base=OUTPUT_BASE)
        result = converter.convert(
            input_path, preset_name,
            fit_mode_override=FitMode.FIT if use_fit_mode else None,
        )

    if result.success:
        print(f"Done! Output: {result.output_path}")
        return 0
    print(result.message)
    return 1


